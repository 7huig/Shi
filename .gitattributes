# 统一换行符，避免 Windows/Linux 协作时的 CRLF 噪音
* text=auto eol=lf

# Git 钩子由 sh 执行，必须保持 LF
githooks/* text eol=lf
*.sh text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做文本转换
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.webp binary
*.jks binary
*.keystore binary
