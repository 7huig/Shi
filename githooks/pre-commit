#!/bin/sh
# 提交前检查：单个代码文件不得超过 20 KiB（20480 字节）。
#
# 目的：让模型与人都能整文件阅读、审查；过大的文件通常意味着一个文件承担了
# 多个职责，提交时强制按功能拆分，比事后重构便宜。
#
# 跳过：锁文件、自动生成文件、第三方/构建目录、二进制与资源文件（这些内容
# 本来就不需要模型逐行阅读）。
#
# 临时绕过：ALLOW_LARGE_CODE_FILES=1 git commit ...
set -eu

LIMIT_BYTES=$((20 * 1024))

if [ "${ALLOW_LARGE_CODE_FILES:-0}" = "1" ]; then
    echo "pre-commit: ALLOW_LARGE_CODE_FILES=1，跳过 20 KiB 代码文件检查。" >&2
    exit 0
fi

# 只检查本次提交新增 / 修改 / 复制 / 重命名并已暂存的文件；删除不检查。
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
    exit 0
fi

is_code_file() {
    case "$1" in
        # JVM / Android
        *.kt|*.kts|*.java|*.groovy|*.gradle) return 0 ;;
        # 脚本
        *.sh|*.bash|*.zsh|*.fish|*.ps1|*.py|*.pyi|*.rb|*.php|*.lua) return 0 ;;
        # Web / 前端
        *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.vue|*.svelte|*.html|*.htm|*.css|*.scss|*.less|*.sass) return 0 ;;
        # 原生 / 系统
        *.c|*.h|*.cc|*.cpp|*.cxx|*.hpp|*.hh|*.cs|*.rs|*.go|*.swift|*.m|*.mm|*.dart|*.sql) return 0 ;;
        # Android 资源与清单也是需要阅读的代码
        *.xml) return 0 ;;
        *) return 1 ;;
    esac
}

is_skipped() {
    path=$1
    base=${path##*/}
    lower=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')

    # 锁文件：内容由包管理器生成，逐行读没有意义。
    case "$lower" in
        *lock|*lockfile|*lock.json|*lock.yaml|*lock.yml|*.lock|*.lockfile|*.lockb) return 0 ;;
    esac
    case "$base" in
        package-lock.json|pnpm-lock.yaml|yarn.lock|bun.lockb|Cargo.lock|poetry.lock|Pipfile.lock|composer.lock|Gemfile.lock|go.sum|gradle.lockfile) return 0 ;;
    esac

    # 第三方代码、构建产物与自动生成目录。
    case "$lower" in
        */node_modules/*|*/vendor/*|*/third_party/*|*/third-party/*|*/external/*|*/deps/*) return 0 ;;
        */build/*|*/dist/*|*/out/*|*/target/*|*/generated/*|*/generated-sources/*|*/gen/*) return 0 ;;
        */.gradle/*|*/.kotlin/*|*/.idea/*) return 0 ;;
    esac

    # 自动生成 / 压缩后的文件：常见命名约定。
    case "$base" in
        *.min.js|*.min.css|*.pb.*|*_pb2.py|*.g.dart|*.freezed.dart|*.generated.*|*.designer.cs|*.g.cs|*.generated.kt|*.generated.java) return 0 ;;
    esac

    # 头部带“自动生成”标记的文件也跳过（覆盖没有统一命名的生成器）。
    if git cat-file -e ":$path" 2>/dev/null; then
        if git cat-file blob ":$path" 2>/dev/null | head -c 2048 | grep -qiE 'auto-generated|autogenerated|automatically generated|do not edit|@generated|此文件.*(自动|生成)|自动生成'; then
            return 0
        fi
    fi

    return 1
}

human_size() {
    awk -v bytes="$1" 'BEGIN { printf "%.1f KiB", bytes / 1024 }'
}

offenders=$(mktemp 2>/dev/null || printf '%s' ".git/pre-commit-large.$$")
trap 'rm -f "$offenders"' EXIT HUP INT TERM

found=0
while IFS= read -r path; do
    [ -n "$path" ] || continue
    is_code_file "$path" || continue
    is_skipped "$path" && continue

    size=$(git cat-file -s ":$path" 2>/dev/null) || continue
    case "$size" in
        ''|*[!0-9]*) continue ;;
    esac
    if [ "$size" -gt "$LIMIT_BYTES" ]; then
        printf '  %10s  %s\n' "$(human_size "$size")" "$path" >>"$offenders"
        found=1
    fi
done <<EOF
$staged
EOF

if [ "$found" -eq 0 ]; then
    exit 0
fi

cat >&2 <<EOF

✗ 提交被 pre-commit 拦截：以下代码文件超过 20 KiB（20480 字节）上限。
  过大的文件难以整文件阅读与审查，也容易把多个职责揉在一起。

$(cat "$offenders")

请按功能拆分后再提交，例如：
  • 一个文件只负责一个屏幕 / 一个可复用组件 / 一组纯函数；
  • UI、ViewModel、领域逻辑、测试夹具分别放到独立文件；
  • 同一功能的测试可以按行为拆成多个测试类，共享夹具放在单独文件；
  • 拆分后重新编译并运行 testDebugUnitTest，确认软件效果不变。

锁文件、自动生成文件、第三方代码与构建产物已自动跳过。
如确属无法拆分的数据文件，可临时放行：ALLOW_LARGE_CODE_FILES=1 git commit ...
EOF

exit 1
